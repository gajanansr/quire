<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Folio makes no network calls. It does not declare INTERNET either, and
      that is not the same thing: ML Kit's bundled text recogniser runs wholly
      on-device but its dependency graph pulls in Google's datatransport
      logging backend, which declares INTERNET for itself and schedules its own
      uploads. Removing the permission is the enforceable version of the
      promise Settings makes to the reader — with no INTERNET the OS refuses
      the socket, whatever a transitive dependency intends.

      The WorkManager permissions that survive the merge (WAKE_LOCK,
      FOREGROUND_SERVICE, RECEIVE_BOOT_COMPLETED, ACCESS_NETWORK_STATE) are
      kept on purpose: they schedule and sustain local work — a long OCR import
      must survive the screen going off — and none of them can move a byte off
      the device. NoNetworkPermissionTest holds this line.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <application
        android:name=".FolioApp"
        android:label="Folio"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Folio">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Folio"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The one door out. A share writes a single PNG into the app cache and grants
          the receiving app read access to that uri alone, for that hand-off. Not
          exported: nothing can reach it without being handed the uri by the reader's
          own tap on Share.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shares"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Folio provides its own WorkManager configuration so ImportWorker can be
          constructed with its dependencies. The default initializer must be removed
          or it wins the race and the custom factory is never used.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
