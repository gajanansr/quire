<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Quire makes no network calls. It does not declare INTERNET either, and
      that is not the same thing: ML Kit's bundled text recogniser runs wholly
      on-device but its dependency graph pulls in Google's datatransport
      logging backend, which declares INTERNET for itself and schedules its own
      uploads. Removing the permission is the enforceable version of the
      promise Settings makes to the reader — with no INTERNET the OS refuses
      the socket, whatever a transitive dependency intends.

      The WorkManager permissions that survive the merge (WAKE_LOCK,
      FOREGROUND_SERVICE, RECEIVE_BOOT_COMPLETED, ACCESS_NETWORK_STATE) are
      kept on purpose: they schedule and sustain local work — a long OCR import
      must survive the screen going off — and none of them can move a byte off
      the device. NoNetworkPermissionTest holds this line.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!--
      Reading reminders. Local only: it lets Quire put a line of its own text in
      the reader's own shade, and it cannot move a byte anywhere. Asked for at
      runtime on Android 13+, and only after the reader has said yes inside the
      app first — see notify/ReminderPermission.kt.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      What Quire is allowed to see of the reader's other apps, and why it has to ask.

      Translate and Dictionary are not features Quire implements — it has no INTERNET
      permission and could not. They hand the chosen passage to an app the reader
      already has, exactly the way Share does, and Quire's part ends there.

      From Android 11 an app cannot see a package it has not declared an interest in.
      queryIntentActivities does not fail in that case; it returns an *empty list*,
      so without this element Quire would conclude — wrongly, silently, and only on
      API 30 and above — that the reader has no translation app at all, hide the
      action, and give nobody anything to debug. That is why these three are here and
      why HandoffIntentsTest reads this file back: an action probed in
      HandoffIntents.candidates and missing below fails the build rather than the
      phone.

      Three named actions, and not QUERY_ALL_PACKAGES. Asking to see every app on
      someone's phone to find out whether one of them speaks French is a permission
      Play treats as sensitive and a trade this app has no business making.

      The shapes match the intents Quire actually starts. PROCESS_TEXT carries
      text/plain because its handlers declare a mime type; TRANSLATE and DEFINE carry
      none because theirs do not, and a <data> element here would match nothing.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TRANSLATE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DEFINE" />
        </intent>
    </queries>

    <application
        android:name=".QuireApp"
        android:label="Quire"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Quire">

        <!--
          singleTask because Quire is opened from outside itself — a widget today, a
          reminder next. FLAG_ACTIVITY_SINGLE_TOP on the intent is not enough: it only
          reuses the activity when it is already the top of the target task, and a
          launcher starting one with NEW_TASK usually is not in that state. Without a
          launchMode the default is `standard`, which allows unlimited copies, and
          tapping the widget three times built three MainActivity instances stacked on
          each other — the app appeared to relaunch and Back peeled the copies off one
          by one. Measured, not assumed: WidgetLaunchTest holds it.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Quire"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The one door out. A share writes a single PNG into the app cache and grants
          the receiving app read access to that uri alone, for that hand-off. Not
          exported: nothing can reach it without being handed the uri by the reader's
          own tap on Share.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shares"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Home-screen widgets. Exported because the system, not Quire, delivers
          APPWIDGET_UPDATE to them — an unexported provider is simply never drawn,
          and nothing in the app looks wrong while that is true.

          They read the same database the app does and write nothing, and they add no
          permission: NoNetworkPermissionTest is the check that this stays true.
        -->
        <receiver
            android:name=".widget.HabitWidgetProvider"
            android:exported="true"
            android:label="@string/widget_habit_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_habit_info" />
        </receiver>

        <receiver
            android:name=".widget.StatsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_stats_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_info" />
        </receiver>

        <!--
          Quire provides its own WorkManager configuration so ImportWorker can be
          constructed with its dependencies. The default initializer must be removed
          or it wins the race and the custom factory is never used.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
