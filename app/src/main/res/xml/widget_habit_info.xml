<?xml version="1.0" encoding="utf-8"?>
<!--
  Both sizing vocabularies, on purpose.

  minWidth / minHeight / minResizeWidth / minResizeHeight are what API 26 to 30
  reads. targetCellWidth / targetCellHeight and maxResizeWidth / maxResizeHeight are
  API 31's grid, which places a widget by cells rather than by guessing from dips.
  Dropping either set is a silent regression on half the devices in use; an attribute
  the running platform does not know is simply not read.

  updatePeriodMillis is 1800000 — the platform's floor — because this is the one
  widget whose content changes with nothing happening: at midnight "minutes today"
  resets and a streak can break. FolioWidgets.refresh keeps it current the rest of
  the time, so this is a backstop and not the mechanism.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_habit_description"
    android:initialLayout="@layout/widget_habit"
    android:maxResizeHeight="180dp"
    android:maxResizeWidth="360dp"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="180dp"
    android:minWidth="250dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_habit_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
