<!--
  The only thing Quire ever exposes to another app: one PNG, in the app cache,
  written the moment the reader taps Share and granted per-uri for that hand-off.
  No books, no library, no reading history.
-->
<paths>
    <cache-path name="shares" path="shares/" />
</paths>
