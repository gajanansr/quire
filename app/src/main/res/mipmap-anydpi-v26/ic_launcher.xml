<?xml version="1.0" encoding="utf-8"?>
<!--
  Light serif type on the accent ground, which is how the handoff draws a book
  cover: "gradient swatches + serif type-on-color". The icon is the smallest
  possible cover. The monochrome layer lets Android 13+ tint it for themed icons.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
