<?xml version="1.0" encoding="utf-8"?>
<!--
  The hairline round the card.

  A separate drawable from `widget_surface` because a colour filter paints one
  colour, and the card and its edge are two — the same reason the day bars and the
  progress track are separate views rather than one drawable with two layers.

  It is what stops a near-white card dissolving into a pale wallpaper, and it is the
  same border token every card inside the app carries. No solid: only the stroke is
  drawn, so the fill beneath shows through.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke android:width="1dp" android:color="#FFFFFFFF" />
    <corners android:radius="@dimen/widget_corner_radius" />
</shape>
