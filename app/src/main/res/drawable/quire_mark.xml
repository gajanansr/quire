<?xml version="1.0" encoding="utf-8"?>
<!--
  The Quire mark, drawn for a corner of a widget.

  Not `ic_` anything: the `ic_*` drawables are the Lucide set, and `QuireIconsTest`
  asserts every one of them is named in `QuireIcons`. This is Quire's own mark, the
  same drawing the launcher icon carries, and it belongs with the launcher art rather
  than with a borrowed icon family.

  The same fold as `ic_launcher_foreground` — one sheet folded once, two leaves
  meeting at a fold — and deliberately not the same file, for two reasons:

  - **One colour, not two.** The launcher's left leaf is the page colour held back
    to 0.8 alpha, which is the gutter shadow, and it works because a launcher icon
    has one fixed ground under it. A widget has five: Paper, Sepia, E-ink, Night,
    Black. That tonal split is mud on Black, invisible on E-ink, and cannot be
    tinted to any of them. One flat fill can, so the mark is one flat fill and the
    provider tints it with the theme's muted colour, exactly as `ic_flame` is tinted
    at its use site.

  - **A fold that survives being small.** The launcher's canvas is 108dp and most of
    it is the adaptive-icon safe circle; its fold narrows to well under a unit at
    mid-height. Scaled to 16dp on a home screen that crease closes and the mark
    reads as a rounded rectangle. Here the grid is 24, the gap is 3.2 units at the
    head and tail and about 2.1 at mid-height, and `QuireMarkTest` holds that floor.

  Everything else is carried over, because it is what makes it paper: the fold is
  narrowest at mid-height so it reads as one creased sheet, and the head and tail
  edges wave rather than run straight, because a leaf lying open is never flat.

  The fill is white because the tint replaces it — `setColorFilter`'s SRC_ATOP blend
  keeps the shape's alpha and takes the colour from the filter — and white is what
  every other tinted shape in this package is drawn in, so the convention is one
  thing rather than two.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The near leaf. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10.4 6.6
            C 8.0 5.3, 5.2 4.7, 3.0 5.0
            C 2.5 5.1, 2.1 5.5, 2.1 6.0
            L 2.1 17.5
            C 2.1 18.1, 2.6 18.5, 3.1 18.4
            C 5.3 18.1, 8.1 18.6, 10.4 19.9
            C 11.0 17.1, 11.0 9.4, 10.4 6.6
            Z" />

    <!-- The far leaf, the same sheet mirrored across the crease. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M13.6 6.6
            C 16.0 5.3, 18.8 4.7, 21.0 5.0
            C 21.5 5.1, 21.9 5.5, 21.9 6.0
            L 21.9 17.5
            C 21.9 18.1, 21.4 18.5, 20.9 18.4
            C 18.7 18.1, 15.9 18.6, 13.6 19.9
            C 13.0 17.1, 13.0 9.4, 13.6 6.6
            Z" />
</vector>
