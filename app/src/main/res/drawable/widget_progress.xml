<?xml version="1.0" encoding="utf-8"?>
<!--
  The progress bar on the stats widget.

  Border for the track and accent for the fill, which is the same pair the week strip
  uses: in Quire, "not yet" is the border colour and "done" is the accent. A
  ProgressBar is the only bar a RemoteViews can draw, so the progress drawable is
  where the whole appearance has to live.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_border" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_accent" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
